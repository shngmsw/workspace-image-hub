# Generated from src/server/config.ts ENV_VARS by `pnpm gen:env-docs`. Do not edit by hand.
# Required: APP_URL, AUTH_SECRET, GOOGLE_CLIENT_ID, and at least one of ALLOWED_DOMAINS / ALLOWED_EMAILS.
# Everything else has a default. Comments sit on their own lines: env-file parsers disagree about
# inline comments. An empty value (FOO=) means the default.

# ---------- Core
# Public origin of the app, e.g. https://img.example.com. No path. Add it to the OAuth client's
# Authorized JavaScript origins.
APP_URL=http://localhost:3000
# Product name shown in the UI and page title.
# APP_NAME=Image Hub
# auto | ja | en. auto = the user's language toggle, then Accept-Language.
# APP_LOCALE=auto
# Listen port. Cloud Run injects 8080.
# PORT=3000

# ---------- Auth
# At least 32 characters. Signs session cookies. Generate with `openssl rand -base64 32`.
AUTH_SECRET=
# OAuth 2.0 Web client id (<project-number>-<hash>.apps.googleusercontent.com). Used by the Sign
# in with Google button and the Drive picker.
GOOGLE_CLIENT_ID=
# Comma list of Google Workspace domains, e.g. example.com,example.co.jp. A managed account (ID
# token has `hd`) passes when `hd` or its email domain is listed, exactly. Consumer accounts never
# pass a domain rule.
ALLOWED_DOMAINS=
# Comma list of individual addresses (any Google account). At least one of ALLOWED_DOMAINS /
# ALLOWED_EMAILS must be set.
# ALLOWED_EMAILS=
# Comma list of members who may delete any image. Everyone else may delete only their own.
# ADMIN_EMAILS=
# Session lifetime in hours (1..720). A member removed in Google Workspace keeps access at most
# this long; removing them from the allow-list cuts access on the next request.
# SESSION_TTL_HOURS=12

# ---------- Google Drive import
# Browser API key restricted to the Picker API and the APP_URL referrer. Unset = the Drive button
# is hidden.
# GOOGLE_PICKER_API_KEY=
# Cloud project number for the Picker. Derived from GOOGLE_CLIENT_ID when unset.
# GOOGLE_PROJECT_NUMBER=

# ---------- Storage
# local | gcs. local is refused on Cloud Run, whose disk is ephemeral.
# STORAGE_DRIVER=local
# local driver root. Must support hard links. The Docker image sets /data (a volume).
# DATA_DIR=./data
# Private bucket for records, and for images unless GCS_PUBLIC_BUCKET is set.
# GCS_BUCKET=
# Optional public-read bucket for images only. Links then point at storage.googleapis.com and keep
# working while the app is down.
# GCS_PUBLIC_BUCKET=
# Override the base of public links (CDN or custom domain). Default: APP_URL/i, or the public
# bucket URL.
# IMAGE_BASE_URL=

# ---------- Image policy
# Long-edge cap in px (16..8192). Images are never upscaled.
# IMAGE_MAX_DIMENSION=1024
# WebP quality (1..100).
# WEBP_QUALITY=80
# Per-file upload cap in MiB (1..100; at most 31 on Cloud Run, whose request limit is 32 MiB).
# MAX_UPLOAD_MB=20
# Decoded pixels allowed per upload, all animation frames counted (1000000..1000000000). Guards
# memory against pixel bombs.
# IMAGE_MAX_INPUT_PIXELS=100000000
