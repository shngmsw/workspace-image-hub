{
  "name": "workspace-image-hub",
  "version": "0.1.0",
  "description": "Self-hosted WebP image hub for Google Workspace: Drive picker, domain-restricted sign-in, Google Chat avatarUrl copy.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:env-docs": "tsx scripts/gen-env-docs.ts",
    "smoke": "sh scripts/smoke.sh"
  },
  "dependencies": {
    "@google-cloud/storage": "8.2.0",
    "@hono/node-server": "2.1.1",
    "google-auth-library": "11.1.0",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hono/vite-dev-server": "0.26.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
